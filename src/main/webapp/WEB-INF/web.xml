<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>SoraCare-FPUNE</display-name>

    <filter>
        <filter-name>VigenciaSesion</filter-name>
        <filter-class>py.fpune.soracare.security.FiltroVigenciaSesion</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>VigenciaSesion</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFormularios</filter-name>
        <filter-class>py.fpune.soracare.security.FiltroCsrfFormularios</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFormularios</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>SentryErroresFilter</filter-name>
        <filter-class>py.fpune.soracare.security.SentryErroresFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SentryErroresFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>SeguridadApiRest</filter-name>
        <filter-class>py.fpune.soracare.security.FiltroSeguridadApiRest</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SeguridadApiRest</filter-name>
        <url-pattern>/api/v1/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>apiRest</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextClass</param-name>
            <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
        </init-param>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>py.fpune.soracare.api.config.ApiRestConfiguracion</param-value>
        </init-param>
        <load-on-startup>2</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>apiRest</servlet-name>
        <url-pattern>/api/v1/*</url-pattern>
    </servlet-mapping>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/errores/403.jsp</location>
    </error-page>

</web-app>
