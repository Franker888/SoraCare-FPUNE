<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ page import="py.fpune.soracare.dto.ResumenUsuariosDTO" %>
<%@ page import="py.fpune.soracare.dto.UsuarioAdministrativoDTO" %>
<%@ page import="java.time.format.DateTimeFormatter" %>
<%!
    private String h(String valor) { if (valor == null) return ""; return valor.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;"); }
%>
<%
    ResumenUsuariosDTO resumen = (ResumenUsuariosDTO) request.getAttribute("resumen");
    String error = (String) request.getAttribute("error");
    String q = request.getParameter("q") == null ? "" : request.getParameter("q");
    String estadoFiltro = request.getParameter("estado") == null ? "" : request.getParameter("estado");
    boolean exito = "actualizado".equals(request.getParameter("resultado"));
    DateTimeFormatter fechaHora = DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm");
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Usuarios | SoraCare-FPUNE</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/libs/bootstrap/bootstrap.min.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app/css/soracare-app.css?v=20260815b"></head>
<body class="app-shell app-admin"><%@ include file="_navbar.jspf" %><main class="container py-4 py-lg-5">
<section class="admin-hero mb-4"><div class="row align-items-center"><div class="col-lg-9"><div class="admin-eyebrow">Etapa 8 · Control de acceso</div><h1>Usuarios y accesos</h1><p>Consultá las cuentas registradas, detectá bloqueos y controlá quién puede ingresar al sistema.</p></div><div class="col-lg-3 text-lg-end"><span class="admin-hero-icon"><i class="bi bi-people"></i></span></div></div></section>
<% if (exito) { %><div class="alert alert-success">La cuenta se actualizó correctamente.</div><% } %><% if (error != null) { %><div class="alert alert-danger"><%= h(error) %></div><% } %>
<% if (resumen != null) { %><section class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card admin-stat-card"><i class="bi bi-people admin-stat-icon"></i><div class="admin-stat-value"><%= resumen.total() %></div><div class="admin-stat-label">Cuentas registradas</div></div></div><div class="col-6 col-lg-3"><div class="card admin-stat-card"><i class="bi bi-person-check admin-stat-icon"></i><div class="admin-stat-value"><%= resumen.activos() %></div><div class="admin-stat-label">Activas</div></div></div><div class="col-6 col-lg-3"><div class="card admin-stat-card"><i class="bi bi-lock admin-stat-icon"></i><div class="admin-stat-value text-warning"><%= resumen.bloqueados() %></div><div class="admin-stat-label">Bloqueadas</div></div></div><div class="col-6 col-lg-3"><div class="card admin-stat-card"><i class="bi bi-person-x admin-stat-icon"></i><div class="admin-stat-value text-danger"><%= resumen.inactivos() %></div><div class="admin-stat-label">Inactivas</div></div></div></section><% } %>
<section class="card admin-filter-card mb-4"><div class="admin-section-heading"><div><h2 class="h5">Buscar cuentas</h2><p class="text-secondary mb-0">Por nombre, usuario, cédula o correo.</p></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/inicio">Volver a administración</a></div><form method="get" class="row g-3"><div class="col-md-8"><label class="form-label">Buscar</label><input class="form-control" name="q" maxlength="100" value="<%= h(q) %>" placeholder="Ej.: prueba.recepcion o número de cédula"></div><div class="col-md-3"><label class="form-label">Estado</label><select class="form-select" name="estado"><option value="">Todos</option><% for (String estado : new String[]{"ACTIVO","BLOQUEADO","INACTIVO"}) { %><option value="<%= estado %>" <%= estado.equals(estadoFiltro) ? "selected" : "" %>><%= estado.toLowerCase() %></option><% } %></select></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100"><i class="bi bi-search"></i></button></div></form></section>
<section class="card admin-table-card"><div class="admin-section-heading"><div><h2 class="h5">Cuentas del sistema</h2><p class="text-secondary mb-0">Los cambios de estado se registran en Auditoría.</p></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/roles">Ver roles</a></div>
<% if (resumen == null || resumen.usuarios().isEmpty()) { %><div class="admin-empty"><i class="bi bi-person-exclamation"></i>No se encontraron cuentas.</div><% } else { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Persona</th><th>Cuenta</th><th>Roles</th><th>Seguridad</th><th>Último acceso</th><th>Acción</th></tr></thead><tbody><% for (UsuarioAdministrativoDTO usuario : resumen.usuarios()) { %><tr><td><strong><%= h(usuario.nombreCompleto()) %></strong><br><span class="text-secondary small">CI <%= h(usuario.cedula()) %> · <%= h(usuario.correo()) %></span></td><td><strong>@<%= h(usuario.nombreUsuario()) %></strong><br><span class="badge <%= "ACTIVO".equals(usuario.estado()) ? "text-bg-success" : ("BLOQUEADO".equals(usuario.estado()) ? "text-bg-warning" : "text-bg-secondary") %>"><%= h(usuario.estado().toLowerCase()) %></span></td><td><%= h(usuario.roles()) %></td><td><span class="small">Intentos: <strong><%= usuario.intentosFallidos() %></strong></span><% if (usuario.debeCambiarContrasena()) { %><br><span class="badge text-bg-warning">Debe cambiar contraseña</span><% } %></td><td><%= usuario.ultimoAcceso() == null ? "Nunca" : usuario.ultimoAcceso().format(fechaHora) %></td><td><% if ("BLOQUEADO".equals(usuario.estado())) { %><form method="post"><input type="hidden" name="csrfToken" value="${requestScope.csrfToken}"><input type="hidden" name="accion" value="desbloquear"><input type="hidden" name="idUsuario" value="<%= usuario.idUsuario() %>"><button class="btn btn-sm btn-outline-primary">Desbloquear</button></form><% } else { %><form method="post"><input type="hidden" name="csrfToken" value="${requestScope.csrfToken}"><input type="hidden" name="accion" value="estado"><input type="hidden" name="idUsuario" value="<%= usuario.idUsuario() %>"><input type="hidden" name="nuevoEstado" value="<%= "ACTIVO".equals(usuario.estado()) ? "INACTIVO" : "ACTIVO" %>"><button class="btn btn-sm <%= "ACTIVO".equals(usuario.estado()) ? "btn-outline-danger" : "btn-outline-primary" %>"><%= "ACTIVO".equals(usuario.estado()) ? "Inactivar" : "Activar" %></button></form><% } %></td></tr><% } %></tbody></table></div><% } %></section>
</main><script src="${pageContext.request.contextPath}/assets/libs/bootstrap/bootstrap.bundle.min.js"></script></body></html>
