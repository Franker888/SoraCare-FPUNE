# Copiá este archivo como .env.docker sólo si no usás el script de arranque.
# No guardes contraseñas reales en Git.

SORACARE_POSTGRES_ADMIN_PASSWORD=reemplazar_con_un_secreto_aleatorio
SORACARE_DB_PASSWORD=reemplazar_con_otro_secreto_aleatorio
SORACARE_HTTP_PORT=8081

# Integraciones opcionales. El script también puede reutilizar las variables
# ya configuradas en el perfil de usuario de Windows sin escribirlas aquí.
SORACARE_OPENAI_API_KEY=
SORACARE_OPENAI_MODEL=gpt-5.6-terra
SORACARE_RESEND_API_KEY=
SORACARE_EMAIL_FROM=
SORACARE_TWILIO_ACCOUNT_SID=
SORACARE_TWILIO_AUTH_TOKEN=
SORACARE_TWILIO_FROM=
SORACARE_GOOGLE_CLIENT_ID=
SORACARE_TURNSTILE_SITE_KEY=
SORACARE_TURNSTILE_SECRET_KEY=
SORACARE_SENTRY_DSN=
SORACARE_SENTRY_ENVIRONMENT=docker-local
SORACARE_FIREBASE_API_KEY=
SORACARE_FIREBASE_AUTH_DOMAIN=
SORACARE_FIREBASE_PROJECT_ID=
SORACARE_FIREBASE_STORAGE_BUCKET=
SORACARE_FIREBASE_MESSAGING_SENDER_ID=
SORACARE_FIREBASE_APP_ID=
SORACARE_FIREBASE_VAPID_KEY=
